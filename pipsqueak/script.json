    {"id": "roost",      "start": 14,  "end": 58,  "room": "roost"},
    {"id": "exodus",     "start": 58,  "end": 80,  "room": "tunnel"},
    {"id": "quiet_way",  "start": 80,  "end": 112, "room": "crack"},
    {"id": "dark",       "start": 112, "end": 152, "room": "cathedral"},
    {"id": "shout",      "start": 152, "end": 185, "room": "cathedral"},
